{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1"],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@4.21.0", "mcp"]
    }
  }
}
